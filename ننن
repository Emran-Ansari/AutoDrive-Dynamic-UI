.card {
    position: relative; /* برای اینکه لایه نور نسبت به کارت تنظیم شود */
    background-color: #1f2833;
    border-radius: 16px;
    overflow: hidden; /* بسیار مهم: تا نور از لبه‌های کارت بیرون نزند */
    cursor: pointer;
}

.card::after {
    content: '';
    position: absolute;
    top: 0;
    
    left: -60%; 
    
    width: 30%;
    height: 100%;
    
    background: linear-gradient(
        to right, 
        rgba(255, 255, 255, 0) 0%, 
        rgba(255, 255, 255, 0.071) 30%, 
        rgba(255, 255, 255, 0.238) 50%, /* مرکز هاله کاملاً ملایم و محو است */
        rgba(255, 255, 255, 0.071) 70%, 
        rgba(255, 255, 255, 0) 100%
    );

    
    /* کج کردن لایه نور برای جذابیت بیشتر */
    transform: skewX(1deg); 
    
    /* مدیریت سرعت حرکت رفت و برگشت (۰.۶ ثانیه با حرکت نرم) */
    transition: left 0.7s cubic-bezier(0.25, 1, 0.5, 1);
    
    pointer-events: none; /* جلوگیری از تداخل کلیک موس */
}

/* 🚀 ۳. جادوی هاور: وقتی موس روی کارت می‌رود، نور به سمت راست پرتاب می‌شود */
.card:hover::after {
    left: 130%; /* حرکت سریع نور به بیرون از کادر در سمت راست */
}
