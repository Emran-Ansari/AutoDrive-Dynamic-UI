.card {
    position: relative; 
    background-color: #1f2833;
    border-radius: 16px;
    overflow: hidden; 
    cursor: pointer;
}

.card::after {
    content: '';
    position: absolute;
    top: 0;
    
    left: -60%; 
    
    width: 30%;
    height: 100%;
    
    background: linear-gradient(
        to right, 
        rgba(255, 255, 255, 0) 0%, 
        rgba(255, 255, 255, 0.071) 30%, 
        rgba(255, 255, 255, 0.238) 50%, 
        rgba(255, 255, 255, 0.071) 70%, 
        rgba(255, 255, 255, 0) 100%
    );

    
    
    transform: skewX(1deg); 
    
    
    transition: left 0.7s cubic-bezier(0.25, 1, 0.5, 1);
    
    pointer-events: none; 
}


.card:hover::after {
    left: 130%; 
}
